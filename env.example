# ============================================
# Конфигурация GIBDD Bot + Mini App
# Скопируйте этот файл как .env и заполните значения
# ============================================

# --- Telegram Bot ---
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=ваш_токен_здесь

# --- Сеть ---
# Таймаут запросов к API stat.gibdd.ru (в секундах).
TARGET_API_TIMEOUT=120

# Прокси (если ваш корпоративной сети использует прокси)
HTTP_PROXY=
HTTPS_PROXY=

# --- Доступ (опционально) ---
# Список Telegram ID пользователей через запятую.
# Пусто = доступ всем, кто прошёл проверку initData.
ALLOWED_USER_IDS=

# --- Администраторы (для системных уведомлений) ---
# Список Telegram ID администраторов через запятую.
# Сюда monitor_cards_cache.sh и другие скрипты мониторинга
# будут слать алерты (через Telegram Bot API, используя токен выше).
# Узнать свой ID: напишите @userinfobot в Telegram.
# Пусто = уведомления отключены (алерты только в лог-файл).
ADMIN_TELEGRAM_IDS=

# --- PostgreSQL-кэш (Этап 3) ---
# TTL кэша карточек ДТП в секундах.
# По умолчанию 3600 (1 час) — баланс между актуальностью и хитами.
# Рекомендации:
#   3600   (1 час)    — текущий период (данные ГИБДД могут обновиться)
#   86400  (24 часа)  — закрытые периоды прошлого месяца/года
#   604800 (7 дней)   — демо/презентации, архивный режим
#   300    (5 мин)    — отладка/тестирование
CARDS_CACHE_TTL_SECONDS=3600
EXCEL_CACHE_TTL_SECONDS=86400

# --- Хранилище данных ---
# Директория для кэша (регионы, камеры, OSM-полигоны).
# На bothost.ru используйте /data (если доступно), иначе data/
CAMERA_DATA_DIR=data
GIBDD_PROJECT_PATH=..

# --- Логирование ---
LOG_LEVEL=INFO

# --- LLM (нейросеть для анализа, опционально) ---
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash

# Платный LLM (опционально)
LLM_PAID_API_KEY=
LLM_PAID_API_URL=https://api.aitunnel.ru/v1
LLM_PAID_MODEL=deepseek-v4-flash

# Включать ли поиск новостей для контекста LLM
ENABLE_NEWS_SEARCH=true

# ============================================
# Mini App + bothost.ru настройки
# ============================================

# Домен, который выдал bothost.ru (вида bot1234.bothost.tech)
# ИЛИ ваш собственный домен, привязанный к bothost.
#
# ВАЖНО: указывайте ТОЛЬКО домен БЕЗ протокола https://!
#
# Код сам добавит https:// при построении webhook URL и Mini App URL.
# (Если случайно добавили https:// — код это переживёт, но лучше писать чисто.)
BOTHOST_DOMAIN=bot1234.bothost.tech

# Порт, который bothost передаёт через $PORT (обычно 8080).
# На bothost не меняйте — значение приходит из окружения.
PORT=3000

# CORS: разрешённые origins для Mini App.
# Добавьте сюда ваш bothost-домен и поддомены Telegram WebView.
CORS_ORIGINS=https://bot1234.bothost.tech,https://web.telegram.org,https://a.telegram.org

# Количество воркеров uvicorn (на bothost обычно 1, т.к. тариф ограничен
# и webhook требует единственного процесса). НЕ меняйте на bothost.
# === Сервис ===
APP_HOST=0.0.0.0
APP_PORT=3000
APP_WORKERS=2

# === Tasks ===
# Директория для временного хранения сгенерированных файлов задач
TASKS_DIR=/tmp/gibdd_tasks
# TTL файлов задач в часах
TASKS_TTL_HOURS=24

# === Database (опционально) ===
# Connection string PostgreSQL. Если задан — задачи и аудит-лог
# персистятся в БД (переживают рестарт, видны из всех воркеров).
# Если НЕ задан или БД недоступна — работает in-memory fallback.
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=
# Минимальный/максимальный размер пула соединений
DB_POOL_MIN=1
DB_POOL_MAX=5
# Таймаут подключения (сек)
DB_CONNECT_TIMEOUT=30

# ============================================
# ПОСЛЕ ДЕПЛОЯ: установка webhook для Telegram
# ============================================
# После первого успешного запуска выполните ОДИН РАЗ:
#
# curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://<BOTHOST_DOMAIN>/bot/webhook"
#
# Проверка:
# curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getWebhookInfo"
#
# Удаление webhook (если нужно вернуться на polling для локальной разработки):
# curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/deleteWebhook"
