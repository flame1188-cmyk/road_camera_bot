{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "npbdd.vehicles.json",
  "title": "NPBDD Vehicles (Kts per region per year)",
  "type": "object",
  "required": ["region_code", "region_name", "vehicles_by_year", "source", "loaded_at"],
  "properties": {
    "region_code": {"type": "string", "pattern": "^[0-9]{2,4}$"},
    "region_name": {"type": "string", "minLength": 1},
    "vehicles_by_year": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}$": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source": {"type": "string", "minLength": 1},
    "loaded_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
