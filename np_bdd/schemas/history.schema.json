{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "npbdd.history.json",
  "title": "NPBDD History (precalculated Tp per region per year)",
  "type": "object",
  "required": ["region_code", "region_name", "years"],
  "properties": {
    "region_code": {"type": "string", "pattern": "^[0-9]{2,4}$"},
    "region_name": {"type": "string", "minLength": 1},
    "years": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}$": {
          "type": "object",
          "required": ["deaths", "vehicles", "tr", "calculated_at"],
          "properties": {
            "deaths": {"type": "integer", "minimum": 0},
            "vehicles": {"type": "integer", "minimum": 0},
            "tr": {"type": "number", "minimum": 0},
            "calculated_at": {"type": "string", "format": "date"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
