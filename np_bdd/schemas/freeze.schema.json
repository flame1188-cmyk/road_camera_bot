{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "npbdd.freeze.json",
  "title": "NPBDD Frozen Years (manual lock for a region+year)",
  "type": "object",
  "required": ["region_code", "frozen_years"],
  "properties": {
    "region_code": {"type": "string", "pattern": "^[0-9]{2,4}$"},
    "frozen_years": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}$": {
          "type": "object",
          "required": ["deaths", "vehicles", "tr", "frozen_at", "frozen_by"],
          "properties": {
            "deaths": {"type": "integer", "minimum": 0},
            "vehicles": {"type": "integer", "minimum": 0},
            "tr": {"type": "number", "minimum": 0},
            "frozen_at": {"type": "string", "format": "date"},
            "frozen_by": {"type": "string", "minLength": 1},
            "source_deaths_breakdown": {
              "type": "object",
              "patternProperties": {
                "^([1-9]|1[0-2])$": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "note": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
